{
  "name": "ai-collab",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI collaboration hub with TypeScript core and unified CLI collaboration flow.",
  "packageManager": "pnpm@10.10.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "link:cli": "pnpm run build && npm --workspace apps/cli link",
    "pack:user": "pnpm run build && node scripts/pack-user-package.mjs && pnpm pack ./release/ai-collab --json --cache .npm-cache --pack-destination ./release/ai-collab",
    "unlink:cli": "npm unlink -g ai-collab",
    "typecheck": "pnpm -r --if-present run typecheck",
    "smoke": "pnpm run build && node scripts/smoke.mjs",
    "smoke:named": "pnpm run build && node scripts/smoke-named.mjs",
    "smoke:cli:loop": "pnpm run build && node scripts/smoke-cli-loop.mjs",
    "smoke:cli:wait-continuation": "pnpm run build && node scripts/smoke-cli-wait-continuation.mjs",
    "smoke:cli:wait-takeover": "pnpm run build && node scripts/smoke-cli-wait-takeover.mjs",
    "smoke:cli:message-handoff": "pnpm run build && node scripts/smoke-cli-message-handoff.mjs",
    "smoke:cli:host-execute": "pnpm run build && node scripts/smoke-cli-host-execute.mjs",
    "smoke:cli:host-batch-await": "pnpm run build && node scripts/smoke-cli-host-batch-await.mjs",
    "smoke:cli:session-idle": "pnpm run build && node scripts/smoke-cli-session-idle.mjs",
    "smoke:cli:knowledge": "pnpm run build && node scripts/smoke-cli-knowledge.mjs",
    "smoke:console:api": "pnpm run build && node scripts/smoke-console-api.mjs",
    "smoke:websocket:console-update": "pnpm run build && node scripts/smoke-websocket-console-update.mjs",
    "smoke:cli:attach-reset": "pnpm run build && node scripts/smoke-cli-attach-reset.mjs",
    "smoke:cli:batch-dispatch": "pnpm run build && node scripts/smoke-cli-batch-dispatch.mjs",
    "smoke:message:fail": "pnpm run build && node scripts/smoke-message-fail.mjs",
    "smoke:duplicate-agent-name": "pnpm run build && node scripts/smoke-duplicate-agent-name.mjs",
    "smoke:inbox:filters": "pnpm run build && node scripts/smoke-inbox-filters.mjs",
    "smoke:session:release": "pnpm run build && node scripts/smoke-session-release.mjs",
    "smoke:session:lifecycle": "pnpm run build && node scripts/smoke-session-lifecycle.mjs",
    "smoke:cli:stale-identity": "pnpm run build && node scripts/smoke-cli-stale-identity.mjs",
    "smoke:regression": "pnpm run build && node scripts/smoke-message-fail.mjs && node scripts/smoke-duplicate-agent-name.mjs && node scripts/smoke-inbox-filters.mjs",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint"
  }
}

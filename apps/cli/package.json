{
  "name": "loopmarshal",
  "version": "0.1.0",
  "private": false,
  "description": "Local AI collaboration hub CLI with unified member-session execution commands.",
  "type": "module",
  "bin": {
    "loopmarshal": "dist/apps/cli/src/index.js"
  },
  "main": "dist/apps/cli/src/index.js",
  "types": "dist/apps/cli/src/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "bundledDependencies": [
    "@loopmarshal/core",
    "@loopmarshal/protocol",
    "@loopmarshal/shared",
    "@loopmarshal/sdk",
    "@loopmarshal/store"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loopmarshal/core": "workspace:*",
    "@loopmarshal/protocol": "workspace:*",
    "@loopmarshal/shared": "workspace:*",
    "@loopmarshal/sdk": "workspace:*",
    "commander": "^13.1.0"
  }
}
